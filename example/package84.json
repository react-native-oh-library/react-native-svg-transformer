{
  "name": "react-native-harmony-tester",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run tsc && react-native bundle-harmony --dev false",
    "lint": "eslint .",
    "test": "jest",
    "tsc": "tsc --noEmit",
    "i": "cd ../ && npm i && npm run pack && cd ./example && npm i",
    "reStart": "npm run install:pkg && npm run codegen && hdc rport tcp:8081 tcp:8081 && react-native start",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "codegen": "react-native codegen-harmony --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "pack:pkg": "cd ../ && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-svg-transformer && npm install --legacy-peer-deps @react-native-ohos/react-native-svg-transformer@file:../react-native-ohos-react-native-svg-transformer-1.5.4-beta.1.tgz",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "fast:pkg": "cd ../ && npm i --legacy-peer-deps && npm pack && cd ./example && npm i && npm run dev"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.84.2",
    "@react-native-ohos/react-native-svg": "15.14.0-rc.3",
    "@react-native-ohos/react-native-svg-transformer": "file:../react-native-ohos-react-native-svg-transformer-1.5.4-beta.1.tgz",
    "@rnoh/testerino": "file:./rnoh_package/testerino/rnoh-testerino-0.0.12.tgz",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native-oh/react-native-harmony-cli": "0.84.2",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "^0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "json5": "^2.2.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.5.4",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "metro-react-native-babel-preset": "0.76.8"
  },
  "overrides": {
    "@react-native-community/cli": "20.0.0"
  },
  "resolutions": {
    "@babel/core": "^7.25.2",
    "babel-loader": "^8.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}