{
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.72.140",
    "@react-native-ohos/react-native-svg": "~15.0.2",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-svg": "15.0.0",
    "react-native-svg-transformer": "file:../react-native-svg-transformer-1.5.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "AwesomeProject",
  "overrides": {
    "@react-native-community/cli": "11.3.6",
    "@react-native/codegen": "0.74.0"
  },
  "private": true,
  "resolutions": {
    "@react-native-community/cli": "11.3.6"
  },
  "scripts": {
    "dev": "npm run tsc && react-native bundle-harmony --dev false",
    "lint": "eslint .",
    "test": "jest",
    "tsc": "tsc --noEmit",
    "i": "cd ../ && npm i && npm run pack && cd ./example && npm i",
    "reStart": "npm run install:pkg && npm run codegen && hdc rport tcp:8081 tcp:8081 && react-native start",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "codegen": "react-native codegen-harmony --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "pack:pkg": "cd ../ && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-document-picker && npm install --legacy-peer-deps @react-native-ohos/react-native-document-picker@file:../react-native-svg-transformer-1.5.3.tgz",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "fast:pkg": "cd ../ && npm i --legacy-peer-deps && npm pack && cd ./example && npm i && npm run dev"
  },
  "version": "0.0.1"
}
