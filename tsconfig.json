{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "jsx": "react",
    "sourceMap": true,
    "removeComments": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "index.js",
    "react-native/index.js",
    "expo/index.js"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/*",
    "node_modules/**",
    "oh_modules/**",
    "example*/**",
    "harmony*/**",
    "android/**",
    "ios/**",
    "windows/**",
    "macos/**",
    "linux/**",
    "dist/**",
    "build/**",
    "out/**",
    "lib/**",
    "**/.*/**",
    "__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}