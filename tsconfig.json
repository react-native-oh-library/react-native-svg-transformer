{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "types": ["jest"],
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string"
    ],
    "allowJs": true,
    "jsx": "react",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "removeComments": false,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "allowImportingTsExtensions": false,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "resolvePackageJsonImports": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false
  },
  "include": [
    "index.js",
    "react-native/index.js",
    "expo/index.js"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/*",
    "node_modules/**",
    "oh_modules/**",
    "example*/**",
    "harmony*/**",
    "android/**",
    "ios/**",
    "windows/**",
    "macos/**",
    "linux/**",
    "dist/**",
    "build/**",
    "out/**",
    "lib/**",
    "**/.*/**",
    "__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
